Options -Indexes

# Keep PHP diagnostics in the server log, including failures occurring before
# the application bootstrap can configure PHP itself.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On
</IfModule>

# Static entry pages do not pass through config.php, so give them the same
# browser protections as PHP responses. "set" replaces rather than appends.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:html?|css|js|json|xml|txt|svg|jpe?g|png|gif|webp|ico|mp4|webm|ogg|woff2?|ttf|otf)$">
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https:; connect-src 'self'; upgrade-insecure-requests"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Header always set X-Frame-Options "DENY"
        Header always set Strict-Transport-Security "max-age=31536000"
    </FilesMatch>
</IfModule>
